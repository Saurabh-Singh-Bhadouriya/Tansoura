# Server
PORT=5001
NODE_ENV=development

# MongoDB Atlas (the ONLY database)
DATABASE_URL="mongodb+srv://USER:PASS@cluster.mongodb.net/sorbazaar?retryWrites=true&w=majority"
MONGODB_URI="mongodb+srv://USER:PASS@cluster.mongodb.net/sorbazaar?retryWrites=true&w=majority"

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES=7d

# Razorpay
RAZORPAY_KEY_ID=rzp_live_xxxx
RAZORPAY_KEY_SECRET=xxxxxxxx

# CORS (comma-separated or single origin)
CORS_ORIGIN=http://localhost:3000